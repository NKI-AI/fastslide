"""FastSlide Python package and wheel distribution.

This BUILD file defines:
- py_library: The FastSlide Python package with native extension
- versioned_py_wheel: Platform-specific wheels for distribution (Python 3.10-3.13)

To build a wheel for a specific Python version and platform:
    bazelisk build --platforms=//platforms:darwin_aarch64 \\
      //python:fastslide_wheel_cp311

To build all wheels (and packages), use the provided script:
    python aifo/fastslide/tools/build_artifacts.py --bazel bazelisk --skip-packages

The wheels are platform-specific because they include native C++ extensions.
Each versioned_py_wheel target uses a Starlark transition to compile the
extension against the correct Python headers for its target version.

Built wheels are collected into:
    aifo/fastslide/artifacts/wheels/
"""

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rules_multirun//:defs.bzl", "multirun")
load("//tools:versioned_py_wheel.bzl", "multi_version_py_wheel")

# Platform-specific compatibility - supports Linux, macOS, and Windows
COMPATIBLE_TARGETS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Platform-specific wheel tags
# These align with PEP 425 wheel naming conventions
WHEEL_PLATFORM = select({
    "//platforms:is_linux_x86_64": "manylinux2014_x86_64",
    "//platforms:is_linux_arm64": "manylinux2014_aarch64",
    "//platforms:is_darwin_aarch64": "macosx_11_0_arm64",
    "//platforms:is_darwin_x86_64": "macosx_10_9_x86_64",
    "//platforms:is_windows_x86_64": "win_amd64",
    "//platforms:is_windows_arm64": "win_arm64",
    "//conditions:default": "any",
})

FASTSLIDE_VERSION = "0.7.5"
# ==============================================================================
# Copy extension binary
# ==============================================================================
# The extension is built by nanobind_extension. Each versioned_py_wheel target
# applies a Starlark transition that selects the correct Python toolchain, so
# the extension is rebuilt with the correct Python headers for each version.

genrule(
    name = "copy_extension_so",
    srcs = ["//src/python:_fastslide.so"],
    outs = ["fastslide/_fastslide.so"],
    cmd = "cp $< $@",
)

genrule(
    name = "copy_extension_pyd",
    srcs = ["//src/python:_fastslide.pyd"],
    outs = ["fastslide/_fastslide.pyd"],
    cmd = "cp $< $@",
)

# Bundle the checked-in nanobind stub file (_fastslide.pyi) into the wheel
# so editors and type-checkers see the C++ binding's surface. The stub is
# regenerated by running:
#     bazelisk run //src/python:_fastslide_stubgen
# after binding changes, and the produced file is checked into the source
# tree at aifo/fastslide/src/python/_fastslide.pyi.
genrule(
    name = "copy_extension_pyi",
    srcs = ["//src/python:_fastslide_pyi_file"],
    outs = ["fastslide/_fastslide.pyi"],
    cmd = "cp $< $@",
)

py_library(
    name = "fastslide",
    srcs = glob(["fastslide/**/*.py"]) + [":copy_extension_pyi"] + select({
        "@platforms//os:windows": [":copy_extension_pyd"],
        "//conditions:default": [":copy_extension_so"],
    }),
    imports = ["."],
    visibility = ["//visibility:public"],
)

# Backwards-compatible alias for older docs/commands.
alias(
    name = "copy_extension",
    actual = select({
        "@platforms//os:windows": ":copy_extension_pyd",
        "//conditions:default": ":copy_extension_so",
    }),
)

# ==============================================================================
# Build wheels for multiple Python versions
# ==============================================================================
# multi_version_py_wheel applies a Starlark configuration transition per
# Python version, ensuring native extensions are compiled against the matching
# Python headers.

PYTHON_VERSIONS = {
    "3.10": "cp310",
    "3.11": "cp311",
    "3.12": "cp312",
    "3.13": "cp313",
    "3.14": "cp314",
}

multi_version_py_wheel(
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    default_version = "3.11",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    name_prefix = "fastslide_wheel",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.10",
    python_versions = PYTHON_VERSIONS,
    strip_path_prefixes = ["python/"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = FASTSLIDE_VERSION,
    deps = [":fastslide"],
)
