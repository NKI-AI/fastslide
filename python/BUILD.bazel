"""FastSlide Python package and wheel distribution.

This BUILD file defines:
- py_library: The FastSlide Python package with native extension
- py_wheel: Platform-specific wheels for distribution (Python 3.9-3.13)

To build wheels for a specific Python version:
    bazelisk build \\
      --@rules_python//python/config_settings:python_version=3.11 \\
      --platforms=//platforms:darwin_aarch64 \\
      //python:fastslide_wheel_cp311

To build all wheels, use the provided script:
    ./aifo/fastslide/python/build_all_wheels.sh

The wheels are platform-specific because they include native C++ extensions.
Each wheel must be built with the matching Python version flag to ensure
the extension is compiled against the correct Python headers.
"""

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rules_multirun//:defs.bzl", "multirun")
load("@rules_python//python:packaging.bzl", "py_wheel")

# Platform-specific compatibility - supports Linux and macOS
COMPATIBLE_TARGETS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Platform-specific wheel tags
# These align with PEP 425 wheel naming conventions
WHEEL_PLATFORM = select({
    "//platforms:is_linux_x86_64": "manylinux2014_x86_64",
    "//platforms:is_linux_arm64": "manylinux2014_aarch64",
    "//platforms:is_darwin_aarch64": "macosx_11_0_arm64",
    "//platforms:is_darwin_x86_64": "macosx_10_9_x86_64",
    "//conditions:default": "any",
})

# ==============================================================================
# Copy extension binary
# ==============================================================================
# The extension is built by pybind_extension which automatically uses the
# correct Python toolchain based on --@rules_python//python/config_settings:python_version
# Each wheel build will use a different Python version, so the extension will be
# rebuilt with the correct Python headers for each version.

genrule(
    name = "copy_extension",
    srcs = ["//src/python:_fastslide"],
    outs = ["fastslide/_fastslide.so"],
    cmd = "cp $< $@",
)

py_library(
    name = "fastslide",
    srcs = glob(["fastslide/**/*.py"]) + [":copy_extension"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "test_import",
    srcs = ["test_import.py"],
    main = "test_import.py",
    deps = [":fastslide"],
)

# ==============================================================================
# Build wheels for multiple Python versions
# ==============================================================================
# Each wheel must be built with the corresponding Python version flag:
#   --@rules_python//python/config_settings:python_version=X.Y
#
# The build script (build_all_wheels.sh) handles this automatically.
# Each build invocation with a different Python version will cause Bazel to
# rebuild the extension with the correct Python headers.

# Python 3.9
py_wheel(
    name = "fastslide_wheel_cp39",
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.9",
    python_tag = "cp39",
    strip_path_prefixes = ["aifo/fastslide/python"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = "0.1.0",
    deps = [":fastslide"],
)

# Python 3.10
py_wheel(
    name = "fastslide_wheel_cp310",
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.9",
    python_tag = "cp310",
    strip_path_prefixes = ["aifo/fastslide/python"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = "0.1.0",
    deps = [":fastslide"],
)

# Python 3.11 (default)
py_wheel(
    name = "fastslide_wheel_cp311",
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.9",
    python_tag = "cp311",
    strip_path_prefixes = ["aifo/fastslide/python"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = "0.1.0",
    deps = [":fastslide"],
)

# Python 3.12
py_wheel(
    name = "fastslide_wheel_cp312",
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.9",
    python_tag = "cp312",
    strip_path_prefixes = ["aifo/fastslide/python"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = "0.1.0",
    deps = [":fastslide"],
)

# Python 3.13
py_wheel(
    name = "fastslide_wheel_cp313",
    author = "Jonas Teuwen",
    author_email = "j.teuwen@nki.nl",
    distribution = "fastslide",
    homepage = "https://github.com/NKI-AI/fastslide",
    license = "Apache-2.0",
    platform = WHEEL_PLATFORM,
    python_requires = ">=3.9",
    python_tag = "cp313",
    strip_path_prefixes = ["aifo/fastslide/python"],
    summary = "High-performance, thread-safe digital pathology slide reader",
    target_compatible_with = COMPATIBLE_TARGETS,
    version = "0.1.0",
    deps = [":fastslide"],
)

# Alias for the default version (Python 3.11)
alias(
    name = "fastslide_wheel",
    actual = ":fastslide_wheel_cp311",
)

# ==============================================================================
# Filegroup for building all wheels at once
# ==============================================================================
# This allows you to build all Python versions with a single command:
#   bazelisk build --platforms=//platforms:darwin_aarch64 //python:all_wheels
#
# Note: Bazel will automatically parallelize the builds

filegroup(
    name = "all_wheels",
    srcs = [
        ":fastslide_wheel_cp310",
        ":fastslide_wheel_cp311",
        ":fastslide_wheel_cp312",
        ":fastslide_wheel_cp313",
        ":fastslide_wheel_cp39",
    ],
)

# Individual filegroups for specific Python version sets
filegroup(
    name = "wheels_python39",
    srcs = [":fastslide_wheel_cp39"],
)

filegroup(
    name = "wheels_python310",
    srcs = [":fastslide_wheel_cp310"],
)

filegroup(
    name = "wheels_python311",
    srcs = [":fastslide_wheel_cp311"],
)

filegroup(
    name = "wheels_python312",
    srcs = [":fastslide_wheel_cp312"],
)

filegroup(
    name = "wheels_python313",
    srcs = [":fastslide_wheel_cp313"],
)
