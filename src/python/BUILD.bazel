load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")

# Python bindings extension module using pybind11_bazel
# This properly handles Python version selection and ABI compatibility
pybind_extension(
    name = "_fastslide",
    srcs = [
        "cache.cpp",
        "fastslide.cpp",
        "reader.cpp",
    ],
    copts = ["-fvisibility=hidden"],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-exported_symbol,_PyInit__fastslide"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":cache",
        ":fastslide_lib",
        ":python_binding_headers",
        ":runtime_global_cache_manager",
        ":runtime_plugin_loader",
        ":runtime_reader_registry",
    ],
)
