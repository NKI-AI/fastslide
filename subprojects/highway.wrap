# Google Highway SIMD library. Upstream ships a meson.build that exposes the
# `hwy_dep` variable (project name `hwy`, pkg-config name `libhwy`). Pinned to
# 1.3.0 to match the version used by the Bazel build. Only used as a fallback
# when libhwy is not found on the system.
[wrap-git]
url = https://github.com/google/highway.git
revision = 1.3.0
depth = 1

[provide]
libhwy = hwy_dep
