# Little CMS 2 (lcms2): ICC color-management engine used to apply embedded
# slide ICC profiles during region decode. Built from the upstream release,
# which ships its own meson build. Revision matches the http_archive in
# MODULE.bazel. Provides the `lcms2` dependency.
[wrap-file]
directory = lcms2-2.19.1
source_url = https://github.com/mm2/Little-CMS/releases/download/lcms2.19.1/lcms2-2.19.1.tar.gz
source_filename = lcms2-2.19.1.tar.gz
source_hash = bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8
source_fallback_url = https://github.com/mesonbuild/wrapdb/releases/download/lcms2_2.19.1-1/lcms2-2.19.1.tar.gz

[provide]
lcms2 = liblcms2_dep
