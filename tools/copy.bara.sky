# copy.bara.sky

# This configuration file sets up a Copybara workflow to sync a specific part of NKI-AI/aiforoncology-internal
# to the NKI-AI/aiforoncology repository.

# Update the following fields according to your needs:
#   - In 'origin', change the URL and ref to match your source repository and branch.
#   - In 'destination', ensure the URL and push branch point to the target repository.
#   - The 'origin_files' glob restricts the sync to the specific part of the project you want to mirror. Adjust it 
#   (e.g., "sync_folder/**") as necessary.

# For local testing, use a file:// URL (update path as needed):
REFERENCE_REPO_URL = "file:///Users/jonasteuwen/Code/aifo-simpletiff"
# For production, use the remote repository:
# REFERENCE_REPO_URL = "git@github.com:NKI-AI/aiforoncology-internal.git"
REFERENCE_BRANCH = "feature/simpletiff-integration"  # The branch in the source repository to sync from.

TARGET_REPO_URL = "git@github.com:NKI-AI/fastslide.git" # The destination repository URL to sync to.
TARGET_BRANCH = "sync/monorepo/internal"  # The branch in the destination repository to sync to.

# Configurable list of files (e.g. README.md)
GENERAL_FILES = [
    "aifo/fastslide/README_PUBLIC.md",
    "aifo/fastslide/meson.build",
    "aifo/fastslide/BUILD.bazel",
    "aifo/fastslide/LICENSE",
    "aifo/fastslide/meson_options.txt",
    "aifo/fastslide/MANIFEST.in",
    "aifo/fastslide/pyproject.toml",
    "aifo/fastslide/requirements_linux.txt",
    "aifo/fastslide/requirements_darwin.txt",
    "aifo/fastslide/MODULE_external.bazel",
    "aifo/fastslide/.bazelignore",
    "aifo/fastslide/.bazelversion",
    "aifo/simpletiff/meson.build",
    "aifo/simpletiff/meson_options.txt",
    "aifo/simpletiff/LICENSE",
    "aifo/simpletiff/README.md",
    "aifo/aifocore/meson.build",
    "aifo/aifocore/LICENSE",
    "aifo/aifocore/README.md",
    "third_party/hwy_mac_fix.patch",
    "third_party/hwy.BUILD",
]

# Configurable list of source globs (e.g. src/python)
SRC_GLOBS = [
    "aifo/fastslide/src/**",
    "aifo/fastslide/include/**",
    "aifo/fastslide/python/**",
    "aifo/fastslide/wasm/**",
    "aifo/aifocore/src/**",
    "aifo/aifocore/include/**",
    "aifo/simpletiff/src/**",
    "aifo/simpletiff/include/**",
    "aifo/simpletiff/python/**",
    "aifo/jpeg-compressor/**",
    "third_party/lodepng/**",
    "third_party/CLI11/**",
]

# Configurable list of other globs for projects to copy over.
OTHER_GLOBS = [
    "aifo/fastslide/benchmarks/**",
    "aifo/fastslide/docs/**",
    "aifo/fastslide/examples/**",
    "aifo/fastslide/tests/**",
    "aifo/fastslide/tools/**",
    "aifo/fastslide/subprojects/*.wrap",  # Only wrap files from subprojects
    "aifo/simpletiff/benchmarks/**",
    "aifo/simpletiff/examples/**",
    "aifo/simpletiff/tests/**",
    "aifo/simpletiff/subprojects/*.wrap",  # Only wrap files from subprojects
    "platforms/",
]

EXCLUDED_FILES = [
    # Exclude Meson build directories
    "**/builddir/**",
    # Exclude .gitignore files (they're monorepo-specific)
    "**/.gitignore",
    # Exclude symlinks from monorepo (we use wrap files in copybara version)
    "tools/copy.bara.sky",
    "aifo/fastslide/subprojects/simpletiff",
    "aifo/fastslide/subprojects/aifocore",
    "aifo/fastslide/subprojects/jpeg-compressor",
    "aifo/simpletiff/subprojects/jpeg-compressor",
]

core.workflow(
    name = "default",
    origin = git.origin(
        url = REFERENCE_REPO_URL,
        ref = REFERENCE_BRANCH,
        partial_fetch = True,  # Use partial clone to avoid downloading all LFS files
    ),
    destination = git.destination(
        url = TARGET_REPO_URL,
        fetch = TARGET_BRANCH,
        push = TARGET_BRANCH,
    ),

    origin_files = GENERAL_FILES + glob(SRC_GLOBS + OTHER_GLOBS, exclude = EXCLUDED_FILES),
    destination_files = glob(["**"]),
    transformations = [
        core.move(
            before = "aifo/fastslide/MODULE_external.bazel", 
            after = "MODULE.bazel"
        ),
        core.move(
            before = "aifo/jpeg-compressor/",
            after = "third_party/jpeg-compressor/"
        ),
        core.move(
            before = "aifo/fastslide/",
            after = ""
        ),
        # Move simpletiff to third_party for copybara-translated version
        core.move(
            before = "aifo/simpletiff/",
            after = "subprojects/simpletiff/",
        ),
        # Move aifocore to third_party for copybara-translated version
        core.move(
            before = "aifo/aifocore/",
            after = "subprojects/aifocore/"
        ),
        core.replace(
            before = "\"aifo/fastslide/src/",
            after = "\"src/",
            regex_groups = {},
            paths = glob(["**/*.cpp", "**/*.h"])
        ),
        core.replace(
            before = "//aifo/fastslide/",
            after = "//",
            paths = glob(["**/BUILD.bazel"]) + ["BUILD.bazel"]),
        core.replace(
            before = "//aifo/fastslide:",
            after = ":",
            paths = glob(["**/BUILD.bazel"]) + ["BUILD.bazel"]),
        core.replace(
            before = "//aifo/aifocore",
            after = "//subprojects/aifocore",
            paths = glob(["**/BUILD.bazel"]) + ["BUILD.bazel"]),
        core.replace(
            before = "//aifo/simpletiff",
            after = "//subprojects/simpletiff",
            paths = glob(["**/BUILD.bazel"]) + ["BUILD.bazel"]),
        core.move(
            before = "README_PUBLIC.md",
            after = "README.md"
        )
    ],
    authoring = authoring.pass_thru("Jonas Teuwen <j.teuwen@nki.nl>")
)

# To execute the workflow, run:
#   bazel run //tools:copybara -- migrate <absolute_path_to_copy.bara.sky>
# If it's your first time running Copybara in specific target, you may need to initialize it first:
#   bazel run //tools:copybara -- migrate <absolute_path_to_copy.bara.sky> --init-history
# You can also use the `--force` flag to overwrite existing files in the destination repository.

# Ensure you have the necessary permissions and that the branches exist in both repositories.
