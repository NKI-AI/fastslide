"""FastSlide Debian packages.

This package produces two Debian packages built with the NATIVE host toolchain
(so the shared object matches the distribution it is installed on):

  - libfastslide_<version>_<arch>.deb   (runtime: self-contained .so + CLI)
  - libfastslide-dev_<version>_all.deb   (development: SDK headers)

Build (on a matching-arch host):
  bazelisk build //package:libfastslide_amd64 //package:libfastslide_dev

The debs are consumed by the release workflow's `build-deb` / `smoke-deb` jobs.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(":defs.bzl", "fastslide_dev_deb", "fastslide_runtime_deb")

package(default_visibility = ["//visibility:public"])

FASTSLIDE_VERSION = "0.8.0"

exports_files([
    "versions.json",
    "ldconfig_postinst.sh",
    "deb_smoke.cpp",
    "Dockerfile",
])

# pkg-config metadata for the -dev package. libfastslide.so is self-contained
# (simpletiff and the other third-party deps are statically linked in), so a
# consumer only needs `-lfastslide`.
write_file(
    name = "fastslide_pc",
    out = "fastslide.pc",
    content = [
        "prefix=/usr",
        "exec_prefix=${prefix}",
        "libdir=${exec_prefix}/lib",
        "includedir=${prefix}/include",
        "",
        "Name: FastSlide",
        "Description: FastSlide digital pathology slide reader",
        "Version: " + FASTSLIDE_VERSION,
        "Libs: -L${libdir} -lfastslide",
        "Cflags: -I${includedir}",
        "",
    ],
    newline = "unix",
)

# -----------------------------------------------------------------------------
# Runtime packages (per Debian architecture). Built natively: the host running
# the build determines the actual machine code, so only build the target whose
# `deb_arch` matches the build host.
# -----------------------------------------------------------------------------

fastslide_runtime_deb(
    name = "libfastslide_amd64",
    deb_arch = "amd64",
    lib = "//:fastslide",
    tool = "//:fastslidetool",
    version = FASTSLIDE_VERSION,
)

fastslide_runtime_deb(
    name = "libfastslide_arm64",
    deb_arch = "arm64",
    lib = "//:fastslide",
    tool = "//:fastslidetool",
    version = FASTSLIDE_VERSION,
)

# -----------------------------------------------------------------------------
# Development package (architecture-independent headers).
# -----------------------------------------------------------------------------

fastslide_dev_deb(
    name = "libfastslide_dev",
    headers = [
        ("//:fastslide_headers", "include"),
        ("@aifocore-cpp//:aifocore_headers", "include"),
        ("@simpletiff//:simpletiff_headers", "include"),
    ],
    pc_file = ":fastslide_pc",
    version = FASTSLIDE_VERSION,
)
