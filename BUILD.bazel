load("@rules_uv//uv:pip.bzl", "pip_compile")

package(default_visibility = ["//visibility:public"])

# Allow other packages (e.g. distribution bundling, the formatter) to reference
# these files.
exports_files([
    "LICENSE",
    "README.md",
    "requirements.in",
    "requirements_linux.txt",
    "requirements_darwin.txt",
    ".clang-format",
    ".ruff.toml",
])

alias(
    name = "format",
    actual = "//tools/format",
)

# Resolve fastslide's runtime/test Python requirements into proper per-platform
# lockfiles. Listing only direct deps in `requirements.in` is not enough --
# rules_python's `pip.parse` does not perform transitive resolution itself, so
# every dep that any wheel imports at runtime (e.g. `pluggy` for pytest) must
# appear in the resolved lockfile. Driving it through `pip_compile` keeps that
# closed automatically.
#
# Generated `*_test` targets are tagged `manual` for the same reason as the
# docs/ requirements tests: the lockfile bakes in a path to `requirements.in`
# that is `requirements.in` for the root module (standalone build) and
# `../fastslide+/requirements.in` when fastslide is loaded as an external dep
# (e.g. via the aifo monorepo's `local_path_override`). No single committed
# file can satisfy both contexts, so we treat freshness checks as a fastslide
# -standalone CI lint that has to be invoked explicitly.
pip_compile(
    name = "generate_requirements_linux_txt",
    python_platform = "x86_64-unknown-linux-gnu",
    requirements_in = "requirements.in",
    requirements_txt = "requirements_linux.txt",
    tags = ["manual"],
)

pip_compile(
    name = "generate_requirements_darwin_txt",
    python_platform = "aarch64-apple-darwin",
    requirements_in = "requirements.in",
    requirements_txt = "requirements_darwin.txt",
    tags = ["manual"],
)

# ============================================================================
# Build Configuration
# ============================================================================

# Build config to choose JPEG decoder
# Set via: bazel build --define=jpeg_decoder=jpgd @fastslide/...
config_setting(
    name = "use_jpgd",
    define_values = {"jpeg_decoder": "jpgd"},
)

# Compiler options for WASM builds
WASM_COPTS = select({
    "@platforms//cpu:wasm32": ["-fexceptions"],
    "//conditions:default": [],
})

# ============================================================================
# Documentation Support
# ============================================================================

# Export all header files for documentation generation
filegroup(
    name = "fastslide_headers",
    srcs = glob(["include/**/*.h"]),
    visibility = [
        "//docs:__pkg__",
        "//package:__pkg__",
    ],
)

# Export all source files for documentation generation
filegroup(
    name = "fastslide_sources",
    srcs = glob(["src/**/*.cpp"]),
    visibility = ["//docs:__pkg__"],
)

# Export Doxyfile for documentation generation
exports_files(
    ["Doxyfile"],
    visibility = ["//docs:__pkg__"],
)

