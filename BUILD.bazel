# ============================================================================
# Build Configuration
# ============================================================================

# Build config to choose JPEG decoder
# Set via: bazel build --define=jpeg_decoder=jpgd //aifo/fastslide/...
config_setting(
    name = "use_jpgd",
    define_values = {"jpeg_decoder": "jpgd"},
)

# Compiler options for WASM builds
WASM_COPTS = select({
    "@platforms//cpu:wasm32": ["-fexceptions"],
    "//conditions:default": [],
})

# ============================================================================
# Documentation Support
# ============================================================================

# Export all header files for documentation generation
filegroup(
    name = "fastslide_headers",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//aifo/fastslide/docs:__pkg__"],
)

# Export all source files for documentation generation
filegroup(
    name = "fastslide_sources",
    srcs = glob(["src/**/*.cpp"]),
    visibility = ["//aifo/fastslide/docs:__pkg__"],
)

# Export Doxyfile for documentation generation
exports_files(
    ["Doxyfile"],
    visibility = ["//aifo/fastslide/docs:__pkg__"],
)

