    name = "python_binding_headers",
    hdrs = [
        "include/fastslide/python/cache.h",
        "include/fastslide/python/reader.h",
    ],
    includes = ["include"],
    visibility = ["//src/python:__pkg__"],
    deps = [
        ":slide_reader",
        "@aifocore-cpp//:concepts",
    ],
)

