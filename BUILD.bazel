# Create a DLL for Windows (or shared lib on Linux/macOS)
cc_binary(
    name = "fastslide_bin",
    copts = [
        "-lpthread",
        "-lwinpthread",
        "-pthread",
        "-winpthread",
        # "-mno-sve",  # Disable SVE for linux_arm64 to workaround hwy compiler issue
    ],
    linkshared = True,
    # Windows DLLs only export symbols marked __declspec(dllexport). Defining
    # FASTSLIDE_BUILDING_DLL flips the FASTSLIDE_API macro in fastslide/c/api.h
    # to that annotation so the C API ends up in the DLL export table. On
    # Linux/macOS the default visibility already exports global symbols, so
    # the define is unnecessary there.
    local_defines = select({
        "@platforms//os:windows": ["FASTSLIDE_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":fastslide_c",
        ":fastslide_lib",
    ],
)

# Platform-specific genrules to rename the output
genrule(
    name = "fastslide_windows",
    srcs = [":fastslide_bin"],
    outs = ["fastslide.dll"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "fastslide_macos",
    srcs = [":fastslide_bin"],
    outs = ["libfastslide.dylib"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

genrule(
    name = "fastslide_linux",
    srcs = [":fastslide_bin"],
    outs = ["libfastslide.so"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

alias(
    name = "fastslide",
    actual = select({
        "@platforms//os:windows": ":fastslide_windows",
        "@platforms//os:macos": ":fastslide_macos",
        "//conditions:default": ":fastslide_linux",
    }),
    visibility = ["//visibility:public"],
)

# C API
cc_library(
    name = "fastslide_c",
    srcs = [
        "src/c/fastslide.cpp",
        "src/c/image.cpp",
        "src/c/internal/debug.h",
        "src/c/internal/error.h",
        "src/c/registry.cpp",
        "src/c/slide_image.cpp",
        "src/c/slide_reader.cpp",
        "src/c/utilities.cpp",
    ],
    hdrs = [
        "include/fastslide/c/api.h",
        "include/fastslide/c/fastslide.h",
        "include/fastslide/c/image.h",
        "include/fastslide/c/registry.h",
        "include/fastslide/c/slide_image.h",
        "include/fastslide/c/slide_reader.h",
        "include/fastslide/c/utilities.h",
    ],
    copts = WASM_COPTS,
    includes = ["include"],
    # Only Windows requires the DLL-export annotation; Unix shared libraries
    # already export global symbols by default. If -fvisibility=hidden is
    # ever introduced for non-Windows builds, add the matching platforms to
    # this select() so FASTSLIDE_API resolves to visibility("default") there.
    local_defines = select({
        "@platforms//os:windows": ["FASTSLIDE_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":fastslide_lib",
        ":runtime_png_decoder",
    ],
)

